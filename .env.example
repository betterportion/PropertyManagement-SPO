# Copy this file to .env and fill in real values.
# Never commit the real .env — it is gitignored.

# --- Required ---

# PostgreSQL connection string (Neon serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# --- Replit-only (auto-provided on Replit, not needed elsewhere) ---

# OIDC client ID. Authentication currently depends on Replit OIDC and will not
# work outside Replit without swapping in another auth provider.
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc

# --- Optional integrations ---

# Monday.com sync. If unset, the integration is silently skipped.
# MONDAY_API_KEY=

# Shared secret for the JotForm webhook endpoint.
# MUST match the secret configured on the JotForm side.
# JOTFORM_WEBHOOK_SECRET=

# JotForm field ID mappings
# JOTFORM_FIELD_TITLE=
# JOTFORM_FIELD_DESCRIPTION=
# JOTFORM_FIELD_CATEGORY=
# JOTFORM_FIELD_PRIORITY=
# JOTFORM_FIELD_LOCATION=
# JOTFORM_FIELD_EMAIL=
# JOTFORM_FIELD_REGION=
# JOTFORM_FIELD_BUILDING=

# JotForm fallback values when a submission omits a field
# JOTFORM_DEFAULT_REGION=
# JOTFORM_DEFAULT_BUILDING=
# JOTFORM_DEFAULT_LOCATION=

# --- Server ---

# Defaults to 5000
# PORT=5000
