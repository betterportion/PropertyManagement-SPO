# Copy this file to .env and fill in real values.
# Never commit the real .env — it is gitignored.

# --- Required ---

# PostgreSQL connection string (Neon serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# --- Authentication (OpenID Connect) ---
#
# Login is standard OIDC and defaults to Replit Auth. On Replit everything here
# is auto-provided, so you can leave this whole section commented out.
#
# To use a different identity provider (Auth0, Okta, Google, Keycloak, ...),
# set the OIDC_* variables below. No code changes are required. Read
# "Swapping the identity provider" in replit.md first -- in particular the note
# about what happens to existing user accounts when the provider changes.

# Auto-provided by Replit. Used as the OIDC client ID unless OIDC_CLIENT_ID is set.
# REPL_ID=

# Discovery root of your identity provider.
# Defaults to https://replit.com/oidc
# OIDC_ISSUER_URL=https://your-tenant.auth0.com

# Client ID issued by your provider. Takes precedence over REPL_ID.
# OIDC_CLIENT_ID=

# Client secret, if your provider issues one. Replit does not use one.
# OIDC_CLIENT_SECRET=

# Internal login strategy prefix only; never shown to users.
# Defaults to "replitauth". Set it to something recognisable after a swap.
# OIDC_PROVIDER_NAME=auth0

# Space-separated scopes.
# Defaults to "openid email profile offline_access".
# offline_access is what allows sessions to refresh without re-prompting the
# user; only drop it if your provider does not support it.
# OIDC_SCOPES=openid email profile offline_access

# Legacy alias for OIDC_ISSUER_URL. Still honoured, prefer OIDC_ISSUER_URL.
# ISSUER_URL=https://replit.com/oidc

# --- Optional integrations ---

# Monday.com sync. If unset, the integration is silently skipped.
# MONDAY_API_KEY=

# Shared secret for the JotForm webhook endpoint.
# MUST match the secret configured on the JotForm side.
# JOTFORM_WEBHOOK_SECRET=

# JotForm field ID mappings
# JOTFORM_FIELD_TITLE=
# JOTFORM_FIELD_DESCRIPTION=
# JOTFORM_FIELD_CATEGORY=
# JOTFORM_FIELD_PRIORITY=
# JOTFORM_FIELD_LOCATION=
# JOTFORM_FIELD_EMAIL=
# JOTFORM_FIELD_REGION=
# JOTFORM_FIELD_BUILDING=

# JotForm fallback values when a submission omits a field
# JOTFORM_DEFAULT_REGION=
# JOTFORM_DEFAULT_BUILDING=
# JOTFORM_DEFAULT_LOCATION=

# --- Server ---

# Defaults to 5000
# PORT=5000
