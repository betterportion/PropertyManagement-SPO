# Copy this file to .env and fill in real values.
# Never commit the real .env -- it is gitignored. Placeholders only in here.
#
# The app does NOT read .env automatically; there is no dotenv in the project.
#   - On Replit, values come from the Secrets pane.
#   - On Render, from the service's Environment tab.
#   - Locally: set -a && . ./.env && set +a
#
# Everything the server reads is listed below, grouped by what it is for.
# `server/config.ts` checks the required ones at boot and reports all the
# problems at once rather than failing later at the first login or upload.


# ===========================================================================
# 1. Required everywhere
# ===========================================================================

# PostgreSQL connection string. Any Postgres works -- Supabase, Neon, RDS, or a
# server you run yourself.
# From Supabase: Project Settings -> Database -> Connection string -> URI.
# Prefer the pooled ("Transaction") connection for the running app; use the
# direct connection for migrations.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Signs session cookies. At least 32 random characters in production -- the
# server refuses to start below that, because a guessable key means a forgeable
# staff session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string


# ===========================================================================
# 2. Login (OpenID Connect)
# ===========================================================================
#
# Login is standard OIDC and is configuration only -- no code change is needed
# to move between providers. `server/auth.ts` is the only provider-aware file.
#
# Inside a Replit workspace these can all be left unset: REPL_ID is provided
# automatically and the issuer defaults to Replit's.
#
# ANYWHERE ELSE (including Render) OIDC_ISSUER_URL and OIDC_CLIENT_ID are
# REQUIRED and the server will not start without them. Replit Auth cannot be
# reused from another host -- it only accepts logins arriving at a replit.dev
# or replit.app address.
#
# Read docs/PRODUCTION_MIGRATION.md before switching providers: existing
# accounts re-link by email address, and anyone whose stored email does not
# match arrives as a brand-new resident account.

# Discovery root of the identity provider.
#   Google Workspace: https://accounts.google.com
#   Auth0:            https://your-tenant.auth0.com
#   Replit (default inside a Replit workspace): https://replit.com/oidc
# OIDC_ISSUER_URL=https://accounts.google.com

# Client ID the provider issued for this application.
# OIDC_CLIENT_ID=

# Client secret, if the provider issues one. Google Workspace and Auth0 do;
# Replit does not (it uses a public client with PKCE).
# OIDC_CLIENT_SECRET=

# Internal Passport strategy prefix. Never shown to users; worth setting to
# something recognisable after a provider change. Defaults to "replitauth".
# OIDC_PROVIDER_NAME=google

# Space-separated scopes. Defaults to "openid email profile".
#
# offline_access -- which lets a session refresh in the background without
# sending the user back to the login screen -- is deliberately NOT in the
# default, because GOOGLE REJECTS IT and fails the login with "invalid_scope".
# A provider that supports it can add it here. The consequence of leaving it
# out (as on Google) is that a session ends when its token expires and the user
# signs in again, which for a staff portal is acceptable.
# OIDC_SCOPES=openid email profile

# Auto-provided by Replit; used as the client ID unless OIDC_CLIENT_ID is set.
# Do not set this by hand.
# REPL_ID=

# Legacy alias for OIDC_ISSUER_URL, still honoured. Prefer OIDC_ISSUER_URL.
# ISSUER_URL=


# ===========================================================================
# 3. File storage
# ===========================================================================

# Where uploaded photos and documents are kept: "local" or "supabase".
#
# Must be set in production -- the server refuses to start without it rather
# than guess. Guessing "local" on a hosted platform appears to work and then
# loses every uploaded file the next time the host rebuilds the filesystem.
# Defaults to "local" in development.
STORAGE_DRIVER=local

# --- when STORAGE_DRIVER=supabase ---

# Project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_URL=

# Service role key, from Project Settings -> API. It bypasses every access rule
# in the project, so it is a server-only secret and must never reach the
# browser or any client bundle.
# SUPABASE_SERVICE_ROLE_KEY=

# Bucket name. Defaults to "uploads". The bucket MUST be private -- the app
# checks permissions itself and then hands out short-lived signed links.
# SUPABASE_STORAGE_BUCKET=uploads

# --- when STORAGE_DRIVER=local ---

# Folder uploads are written to. Defaults to "uploads" (gitignored).
# UPLOAD_DIR=uploads


# ===========================================================================
# 4. Database tuning (optional)
# ===========================================================================

# TLS behaviour: "require" (default for remote hosts, verifies the
# certificate), "no-verify" (encrypted but unverified -- only for a self-signed
# server you control), or "disable". Local hosts default to disabled.
# DATABASE_SSL=require

# Maximum simultaneous database connections. Defaults to 10. Keep the total
# across every running copy below the provider's connection limit; Supabase's
# pooler and Render's instance count both feed into this.
# DATABASE_POOL_MAX=10

# ===========================================================================
# 5. Outbound email (optional)
# ===========================================================================

# Email is off until BOTH of these are set; the portal runs normally without
# them and email-dependent features simply report that email is not set up.
# Setting only one of the two is treated as a mistake and stops the server at
# boot. The values come from the Resend dashboard once SPO's sending domain
# is verified (see issue #49).

# API key from Resend (shown once at creation; looks like re_...).
# RESEND_API_KEY=re_your_api_key_here

# The identity mail is sent as. Must be on the verified sending domain.
# EMAIL_FROM="SPO Housing <housing@example.org>"

# Optional: where replies go, ideally a monitored inbox.
# EMAIL_REPLY_TO=housing-replies@example.org

# Optional: the address people open the portal at, used for the "open this
# request" link in comment email. Unset means the email goes out without a
# link; it is never a boot requirement. Must be http(s) when set.
# APP_URL=https://housing.example.org

# ===========================================================================
# 6. Server (optional)
# ===========================================================================

# Port to listen on. Defaults to 5000. Render sets this itself -- do not
# hardcode it there.
# PORT=5000

# Total upload data that may be processed at once, in bytes. Defaults to 64MB.
# Uploads are held in memory while they are written to storage, so this is what
# stops several large uploads at once from exhausting the instance; requests
# over the ceiling get a "try again in a few seconds" response.
# MAX_UPLOAD_BYTES_IN_FLIGHT=67108864

# NODE_ENV is set by the npm scripts ("development" for `npm run dev`,
# "production" for `npm run start`) and does not need to be set by hand. It
# controls the security headers, secure cookies and the production CSP.
